import java.util.*;

public class Solution {

    public static List<Integer> maxSubarray(List<Integer> arr) {
        int current = arr.get(0);
        int maxSub = arr.get(0);

        int maxNonCont = arr.get(0);

        for (int i = 1; i < arr.size(); i++) {
            int value = arr.get(i);

            current = Math.max(value, current + value);
            maxSub = Math.max(maxSub, current);

            if (value > 0) {
                maxNonCont += value;
            }
        }

        // If all numbers are negative, choose the largest one
        if (maxNonCont <= 0) {
            maxNonCont = Collections.max(arr);
        }

        return Arrays.asList(maxSub, maxNonCont);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();

            List<Integer> arr = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                arr.add(sc.nextInt());
            }

            List<Integer> result = maxSubarray(arr);

            System.out.println(result.get(0) + " " + result.get(1));
        }

        sc.close();
    }
}
